#ifndef mulle__nanovg_h__
#define mulle__nanovg_h__

#include "include.h"

#include <stdint.h>

/*
 *  (c) <|YEAR|> nat <|ORGANIZATION|>
 *
 *  version:  major, minor, patch
 */
#define MULLE__NANOVG_VERSION  ((0UL << 20) | (7 << 8) | 56)


static inline unsigned int   mulle_nanovg_get_version_major( void)
{
   return( MULLE__NANOVG_VERSION >> 20);
}


static inline unsigned int   mulle_nanovg_get_version_minor( void)
{
   return( (MULLE__NANOVG_VERSION >> 8) & 0xFFF);
}


static inline unsigned int   mulle_nanovg_get_version_patch( void)
{
   return( MULLE__NANOVG_VERSION & 0xFF);
}

// mulle-c11 feature: MULLE__NANOVG__GLOBAL
uint32_t   mulle_nanovg_get_version( void);


/*
 * The following files are auto-generated.
 * The _mulle-nanovg-provide header is generated by
 * mulle-match-to-c during a reflect.
 */
#include "_mulle-nanovg-provide.h"

/*
 * The versioncheck header can be generated with
 * mulle-project-dependency-versions, but it is optional.
 */
#ifdef __has_include
# if __has_include( "_mulle-nanovg-versioncheck.h")
#  include "_mulle-nanovg-versioncheck.h"
# endif
#endif

#endif
